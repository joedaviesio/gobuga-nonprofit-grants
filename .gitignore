.env
__pycache__/
*.pyc
.DS_Store

# Runtime data (per-org, created by the app)
orgs/
platform/*
# …except static config (country source manifests) which ships with the code
!platform/sources/
!platform/sources/**

# Frontend
frontend/node_modules/
frontend/.next/
.next/

# Legacy single-tenant dirs (should not exist in multi-tenant)
cases/
cycles/
evidence/
state/
signoffs/
logs/
data/
sessions.json
.gstack/
.venv/
.vendor/
.claude/
plan/

# Planning & reference docs (not wired into the app)
*.md
!CLAUDE.md
!templates/prompts/*.md

# Outreach campaign material (contact lists, plans — not part of the app)
campaigns/
